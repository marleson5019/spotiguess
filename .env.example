# Spotify Client ID (pode ser público no navegador)
VITE_SPOTIFY_CLIENT_ID=COLE_SEU_CLIENT_ID_AQUI

# Public URL of the frontend. For local development:
VITE_SPOTIFY_REDIRECT_URI=http://127.0.0.1:5019/

# Backend URL (Render, Railway etc). In local dev you can keep empty.
VITE_SERVER_URL=

# Backend Render: origens permitidas separadas por vírgula
ALLOWED_ORIGINS=http://127.0.0.1:5019,http://localhost:5019
PORT=5020
